#!/bin/sh
# Run the same lint check as CI before every commit.
# Enable once per clone with:  git config core.hooksPath .githooks
# Skip for one commit with:    git commit --no-verify

root=$(git rev-parse --show-toplevel)
cd "$root" || exit 1

# commits from an IDE often run without the conda env active, so look in the usual env folders first
for ruff in "$root/.conda/bin/ruff" "$root/.venv/bin/ruff" "$(command -v ruff)"; do
    [ -x "$ruff" ] && break
done
if [ ! -x "$ruff" ]; then
    echo "pre-commit: ruff not found; install the dev dependencies or commit with --no-verify" >&2
    exit 1
fi

if ! "$ruff" check . --quiet; then
    echo "pre-commit: 'ruff check .' failed (as CI would); fix the errors above or commit with --no-verify" >&2
    exit 1
fi
